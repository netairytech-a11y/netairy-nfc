<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile - NetAiry Tech</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen p-6">
  <div class="max-w-3xl mx-auto bg-gray-800 p-8 rounded-xl border border-gray-700 shadow-lg">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold"><%= profile ? 'Edit NFC Profile' : 'Create New NFC Profile' %></h1>
      <a href="/netairy-secret-admin-999" class="text-gray-400 hover:text-white">&larr; Back to Dashboard</a>
    </div>

    <form action="/netairy-secret-admin-999/save" method="POST" class="space-y-4">
      <input type="hidden" name="originalSlug" value="<%= profile ? profile.slug : '' %>">
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-300 mb-1">URL Slug (e.g. rahul-sharma)</label>
          <input type="text" name="slug" value="<%= profile ? profile.slug : '' %>" required class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-1">Full Name</label>
          <input type="text" name="name" value="<%= profile ? profile.name : '' %>" required class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-300 mb-1">Job Title</label>
          <input type="text" name="title" value="<%= profile ? profile.title : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-1">Company Name</label>
          <input type="text" name="company" value="<%= profile ? profile.company : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-300 mb-1">Phone Number</label>
          <input type="text" name="phone" value="<%= profile ? profile.phone : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-1">WhatsApp Number</label>
          <input type="text" name="whatsapp" value="<%= profile ? profile.whatsapp : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-300 mb-1">Email Address</label>
          <input type="email" name="email" value="<%= profile ? profile.email : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-1">Website URL</label>
          <input type="text" name="website" value="<%= profile ? profile.website : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
      </div>

      <div>
        <label class="block text-sm text-gray-300 mb-1">Address</label>
        <input type="text" name="address" value="<%= profile ? profile.address : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
      </div>

      <div>
        <label class="block text-sm text-gray-300 mb-1">Bio / About</label>
        <textarea name="bio" rows="3" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white"><%= profile ? profile.bio : '' %></textarea>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-300 mb-1">Avatar Image URL</label>
          <input type="text" name="avatar" value="<%= profile ? profile.avatar : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-1">Banner Image URL</label>
          <input type="text" name="banner" value="<%= profile ? profile.banner : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white">
        </div>
      </div>

      <!-- PRODUCT / SERVICE PHOTOS SECTION -->
      <div class="border-t border-gray-700 pt-4 mt-4">
        <h3 class="text-lg font-semibold text-indigo-400 mb-3">🛍️ Product / Service Photos (Image URLs)</h3>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1">Product Photo 1</label>
            <input type="text" name="product1" value="<%= profile && profile.gallery && profile.gallery[0] ? profile.gallery[0] : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">Product Photo 2</label>
            <input type="text" name="product2" value="<%= profile && profile.gallery && profile.gallery[1] ? profile.gallery[1] : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">Product Photo 3</label>
            <input type="text" name="product3" value="<%= profile && profile.gallery && profile.gallery[2] ? profile.gallery[2] : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://...">
          </div>
        </div>
      </div>

      <!-- SOCIAL MEDIA & GOOGLE LINKS SECTION -->
      <div class="border-t border-gray-700 pt-4 mt-4">
        <h3 class="text-lg font-semibold text-indigo-400 mb-3">🌐 Social Media & Google Links</h3>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1">Google Review / Business URL</label>
            <input type="text" name="google" value="<%= profile ? profile.google : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://g.page/...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">Instagram URL</label>
            <input type="text" name="instagram" value="<%= profile ? profile.instagram : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://instagram.com/...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">Facebook URL</label>
            <input type="text" name="facebook" value="<%= profile ? profile.facebook : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://facebook.com/...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">LinkedIn URL</label>
            <input type="text" name="linkedin" value="<%= profile ? profile.linkedin : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://linkedin.com/in/...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">YouTube URL</label>
            <input type="text" name="youtube" value="<%= profile ? profile.youtube : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://youtube.com/...">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1">Twitter / X URL</label>
            <input type="text" name="twitter" value="<%= profile ? profile.twitter : '' %>" class="w-full p-2 bg-gray-700 border border-gray-650 rounded text-white text-sm" placeholder="https://twitter.com/...">
          </div>
        </div>
      </div>

      <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg font-semibold hover:bg-indigo-500 transition mt-6">Save Profile</button>
    </form>
  </div>
</body>
</html>
