<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.name %> - Digital Business Card</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-gray-900 rounded-3xl shadow-2xl overflow-hidden border border-gray-800 mb-6">
    
    <!-- Banner Image -->
    <div class="h-36 bg-gradient-to-r from-indigo-600 to-purple-600 bg-cover bg-center" style="background-image: url('<%= profile.banner || 'https://images.unsplash.com/photo-1557683316-973673baf926' %>');"></div>
    
    <div class="px-6 pb-8 text-center relative">
      <!-- Avatar Image -->
      <div class="relative -mt-16 mb-4 flex justify-center">
        <img src="<%= profile.avatar || 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>" class="w-28 h-28 rounded-full border-4 border-gray-900 shadow-xl object-cover bg-gray-800">
      </div>
      
      <!-- Name & Title -->
      <h1 class="text-2xl font-bold text-white"><%= profile.name %></h1>
      <p class="text-indigo-400 font-medium text-sm mt-1">
        <%= profile.title %> <% if (profile.title && profile.company) { %>at <% } %> <span class="text-gray-300"><%= profile.company %></span>
      </p>

      <!-- Bio -->
      <% if (profile.bio && profile.bio.trim() !== "") { %>
        <p class="text-gray-400 text-sm mt-3 px-2 leading-relaxed"><%= profile.bio %></p>
      <% } %>

      <!-- Address if available -->
      <% if (profile.address && profile.address.trim() !== "") { %>
        <p class="text-gray-500 text-xs mt-2 flex items-center justify-center gap-1">
          <span>📍</span> <%= profile.address %>
        </p>
      <% } %>

      <!-- Contact & Main Action Buttons (Proper sized & uniform) -->
      <div class="mt-6 space-y-3">
        <% if (profile.phone && profile.phone.trim() !== "") { %>
          <a href="tel:<%= profile.phone %>" class="flex items-center justify-center gap-2 w-full bg-indigo-600 text-white py-3 rounded-xl font-medium shadow-lg shadow-indigo-600/30 hover:bg-indigo-500 hover:scale-[1.02] transition-all duration-300">
            <span>📞</span> Call Now
          </a>
        <% } %>
        
        <% if (profile.whatsapp && profile.whatsapp.trim() !== "") { %>
          <a href="https://wa.me/<%= profile.whatsapp %>" target="_blank" class="flex items-center justify-center gap-2 w-full bg-emerald-600 text-white py-3 rounded-xl font-medium shadow-lg shadow-emerald-600/30 hover:bg-emerald-500 hover:scale-[1.02] transition-all duration-300">
            <span>💬</span> WhatsApp Message
          </a>
        <% } %>
        
        <% if (profile.email && profile.email.trim() !== "") { %>
          <a href="mailto:<%= profile.email %>" class="flex items-center justify-center gap-2 w-full bg-gray-800 text-gray-200 border border-gray-700 py-3 rounded-xl font-medium hover:bg-gray-700 hover:text-white hover:scale-[1.02] transition-all duration-300">
            <span>✉️</span> Send Email
          </a>
        <% } %>
        
        <% if (profile.website && profile.website.trim() !== "") { %>
          <a href="<%= profile.website %>" target="_blank" class="flex items-center justify-center gap-2 w-full bg-blue-600 text-white py-3 rounded-xl font-medium shadow-lg shadow-blue-600/30 hover:bg-blue-500 hover:scale-[1.02] transition-all duration-300">
            <span>🌐</span> Visit Website
          </a>
        <% } %>
      </div>

      <!-- Social Media Buttons (Only shows if link exists) -->
      <% if ((profile.instagram && profile.instagram.trim() !== "") || (profile.facebook && profile.facebook.trim() !== "") || (profile.linkedin && profile.linkedin.trim() !== "") || (profile.youtube && profile.youtube.trim() !== "")) { %>
        <div class="mt-6 pt-4 border-t border-gray-800 flex justify-center gap-3 flex-wrap">
          <% if (profile.instagram && profile.instagram.trim() !== "") { %>
            <a href="<%= profile.instagram %>" target="_blank" class="bg-pink-600/20 text-pink-400 border border-pink-500/30 px-4 py-2 rounded-xl text-xs font-semibold hover:bg-pink-600 hover:text-white transition-all duration-300">Instagram</a>
          <% } %>
          <% if (profile.facebook && profile.facebook.trim() !== "") { %>
            <a href="<%= profile.facebook %>" target="_blank" class="bg-blue-600/20 text-blue-400 border border-blue-500/30 px-4 py-2 rounded-xl text-xs font-semibold hover:bg-blue-600 hover:text-white transition-all duration-300">Facebook</a>
          <% } %>
          <% if (profile.linkedin && profile.linkedin.trim() !== "") { %>
            <a href="<%= profile.linkedin %>" target="_blank" class="bg-sky-600/20 text-sky-400 border border-sky-500/30 px-4 py-2 rounded-xl text-xs font-semibold hover:bg-sky-600 hover:text-white transition-all duration-300">LinkedIn</a>
          <% } %>
          <% if (profile.youtube && profile.youtube.trim() !== "") { %>
            <a href="<%= profile.youtube %>" target="_blank" class="bg-red-600/20 text-red-400 border border-red-500/30 px-4 py-2 rounded-xl text-xs font-semibold hover:bg-red-600 hover:text-white transition-all duration-300">YouTube</a>
          <% } %>
        </div>
      <% } %>

      <!-- PRODUCT / SERVICE GALLERY -->
      <% if (profile.gallery && profile.gallery.length > 0) { %>
        <div class="mt-8 pt-6 border-t border-gray-800 text-left">
          <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-3 text-center">✨ Featured Products & Services</h3>
          <div class="grid grid-cols-2 gap-3">
            <% profile.gallery.forEach(imgUrl => { %>
              <% if (imgUrl && imgUrl.trim() !== "") { %>
                <div class="overflow-hidden rounded-2xl shadow-md border border-gray-800 bg-gray-900 group">
                  <img src="<%= imgUrl %>" alt="Product" class="w-full h-32 object-cover group-hover:scale-110 transition duration-500">
                </div>
              <% } %>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Footer Branding -->
      <div class="mt-8 text-xs text-gray-500 font-medium tracking-wide">
        Powered by <span class="text-indigo-400 font-semibold">NetAiry Tech 🚀</span>
      </div>
      
    </div>
  </div>
</body>
</html>
