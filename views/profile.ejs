<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.name %> - Digital Business Card</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
    <div class="h-32 bg-indigo-600 bg-cover bg-center" style="background-image: url('<%= profile.banner || 'https://images.unsplash.com/photo-1557683316-973673baf926' %>');"></div>
    <div class="px-6 pb-6 text-center relative">
      <div class="relative -mt-16 mb-4 flex justify-center">
        <img src="<%= profile.avatar || 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>" class="w-28 h-28 rounded-full border-4 border-white shadow-md object-cover bg-white">
      </div>
      <h1 class="text-2xl font-bold text-gray-900"><%= profile.name %></h1>
      <p class="text-indigo-600 font-medium text-sm"><%= profile.title %> <% if (profile.company) { %>at <%= profile.company %><% } %></p>
      <% if (profile.bio) { %>
        <p class="text-gray-600 text-sm mt-3"><%= profile.bio %></p>
      <% } %>

      <div class="mt-6 space-y-3">
        <% if (profile.phone) { %>
          <a href="tel:<%= profile.phone %>" class="flex items-center justify-center w-full bg-indigo-600 text-white py-2.5 rounded-xl font-medium hover:bg-indigo-700 transition">📞 Call Now</a>
        <% } %>
        <% if (profile.whatsapp) { %>
          <a href="https://wa.me/<%= profile.whatsapp %>" target="_blank" class="flex items-center justify-center w-full bg-green-600 text-white py-2.5 rounded-xl font-medium hover:bg-green-700 transition">💬 WhatsApp Message</a>
        <% } %>
        <% if (profile.email) { %>
          <a href="mailto:<%= profile.email %>" class="flex items-center justify-center w-full bg-gray-800 text-white py-2.5 rounded-xl font-medium hover:bg-gray-900 transition">✉️ Send Email</a>
        <% } %>
        <% if (profile.website) { %>
          <a href="<%= profile.website %>" target="_blank" class="flex items-center justify-center w-full bg-blue-600 text-white py-2.5 rounded-xl font-medium hover:bg-blue-700 transition">🌐 Visit Website</a>
        <% } %>
      </div>

      <div class="mt-8 text-xs text-gray-400">
        Powered by NetAiry Tech 🚀
      </div>
    </div>
  </div>
</body>
</html>
